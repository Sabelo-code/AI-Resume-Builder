# Copy this file to .env.local and adjust if needed.
#
# URL of your Cloudflare Worker backend (see /worker). This is what the
# frontend calls instead of any AI provider directly — the Worker holds the
# real Gemini API key server-side.
#
# Local dev default (matches `wrangler dev` in /worker): http://localhost:8787/generate
# Production: your deployed Worker URL, e.g.
#   https://resume-builder-api.<your-subdomain>.workers.dev/generate
VITE_AI_ENDPOINT=https://resume-builder-api.sabelo-tshazi-digifycx.workers.dev/generate
